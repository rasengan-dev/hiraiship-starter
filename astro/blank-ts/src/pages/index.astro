---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Astro on Hiraiship">
  <span class="badge">Astro · static site</span>
  <h1>Ready to ship.</h1>
  <p class="subtitle">
    Edit <code>src/pages/index.astro</code>, then deploy it with one command. Every page is
    prerendered to <code>dist/</code>.
  </p>
  <div class="terminal">
    <p><span class="muted">$</span> npx hiraiship deploy</p>
    <p class="muted">✓ Astro detected · 3 pages built</p>
    <p><span class="accent">→</span> https://my-app.hiraiship.app</p>
  </div>
</Layout>
