---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <main class="page">
      <header class="header">
        <a href="/" style="text-decoration: none">⚡ hiraiship</a>
        <nav>
          <a href="/">Home</a>
          <a href="/about">About</a>
          <a href="https://docs.hiraiship.com" target="_blank" rel="noreferrer">Docs</a>
        </nav>
      </header>
      <section class="hero">
        <slot />
      </section>
      <footer class="footer">Hiraiship starter · Astro</footer>
    </main>
  </body>
</html>
